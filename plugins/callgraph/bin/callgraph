#!/usr/bin/env bash
#
# CallGraph plugin launcher. The plugin's bin/ directory is added to the Bash
# tool's PATH while the plugin is active, so skills invoke `callgraph ...` and
# this script finds the binary in one of two locations (in priority order):
#
#   1. ~/.callgraph/bin/<rid>/CallGraph  — installed by the callgraph-setup skill
#   2. <plugin-dir>/<rid>/CallGraph      — bundled locally (dev/CI builds only)
#
# Run `/callgraph:callgraph-setup` to install the binary if neither path exists.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

os="$(uname -s)"
arch="$(uname -m)"
case "$os" in
  Darwin)
    case "$arch" in
      arm64) rid="osx-arm64" ;;
      x86_64) rid="osx-x64" ;;
      *) echo "callgraph: unsupported macOS architecture: $arch" >&2; exit 1 ;;
    esac ;;
  Linux)
    case "$arch" in
      x86_64|amd64) rid="linux-x64" ;;
      *) echo "callgraph: unsupported Linux architecture: $arch" >&2; exit 1 ;;
    esac ;;
  *)
    echo "callgraph: unsupported OS '$os' (Windows uses callgraph.cmd)" >&2
    exit 1 ;;
esac

# Prefer the user-installed binary; fall back to a locally bundled one (dev builds).
user_exe="$HOME/.callgraph/bin/$rid/CallGraph"
bundled_exe="$DIR/$rid/CallGraph"

if [[ -x "$user_exe" ]]; then
  exec "$user_exe" "$@"
elif [[ -x "$bundled_exe" ]]; then
  exec "$bundled_exe" "$@"
else
  echo "callgraph: binary not found for '$rid'." >&2
  echo "Run the setup skill to install it: /callgraph:callgraph-setup" >&2
  exit 1
fi
